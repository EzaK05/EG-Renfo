# Copie ce fichier en ".env" (jamais commité) et remplis avec tes vraies valeurs Neon.
#
# Neon : dans le dashboard du projet (console.neon.tech), l'onglet "Connection Details"
# donne DEUX chaînes différentes — c'est le piège classique à connaître dès le départ :
#   - DATABASE_URL : la connexion "Pooled" (via PgBouncer, port 5432, host se terminant par "-pooler").
#                    C'est celle que Prisma Client utilise en runtime (toutes les requêtes de l'app).
#   - DIRECT_URL   : la connexion "Direct"/non-poolée (sans "-pooler" dans le host).
#                    C'est celle dont `prisma migrate` a besoin (les migrations ne passent pas par PgBouncer).
# Si tu inverses les deux, `npm run prisma:migrate` échoue avec une erreur de connexion peu claire —
# vérifie toujours quelle chaîne contient "-pooler" avant de coller.

DATABASE_URL="postgresql://<user>:<password>@<host>-pooler.<region>.aws.neon.tech/<database>?sslmode=require"
DIRECT_URL="postgresql://<user>:<password>@<host>.<region>.aws.neon.tech/<database>?sslmode=require"

# Secret utilisé pour signer les cookies de session / JWT — génère une vraie valeur aléatoire
# (ex: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`), jamais celle-ci.
SESSION_SECRET="change-me-generate-a-real-random-secret"

PORT=3000
NODE_ENV=development

# Origine autorisée pour le frontend en dev (Vite tourne par défaut sur ce port).
CORS_ORIGIN="http://localhost:5173"
